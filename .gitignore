# --- Rust ---
/target
**/*.rs.bk
*.pdb

# --- Node / frontend ---
node_modules/
frontend/dist/
frontend/.vite/
*.tsbuildinfo

# --- Runtime data ---
/data
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# --- Secrets / local config ---
.env
.env.*
!.env.example

# Certificates, wherever they are generated. ca.key is the private key of an
# authority the whole stack trusts; committing it would hand anyone who reads
# the repository the ability to impersonate every provider.
certs/
docker/certs/
*.key
*.crt
*.csr
*.srl
*.pem

# --- Editors / OS ---
.idea/
.vscode/
.DS_Store
*.swp

# --- Local working notes (not part of the repo) ---
PROJECT_STATUS.md
.remember/
.claude/
